{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5"
  },
  "permissions": {
    "allow": [
      "Bash(aws logs:*)"
    ],
    "ask": [
      "Bash(aws:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "skillOverrides": {
    "agent-install": "off",
    "code-review": "off",
    "dd-audit": "off",
    "dd-audit-ai-activity": "off",
    "dd-audit-compliance-report": "off",
    "dd-audit-cost-spike-investigation": "off",
    "dd-audit-key-compromise": "off",
    "dd-audit-security-investigation": "off",
    "dd-browser-sdk": "off",
    "dd-docs": "off",
    "enable-ssi": "off",
    "find-skills": "off",
    "k9-ownership-byod-setup": "off",
    "llm-obs-eval-bootstrap": "off",
    "llm-obs-eval-pipeline": "off",
    "llm-obs-experiment-analyzer": "off",
    "llm-obs-session-classify": "off",
    "llm-obs-trace-rca": "off",
    "onboarding-summary": "off",
    "service-remapping": "off",
    "setup-matt-pocock-skills": "off",
    "triage-flaky-test": "off",
    "troubleshoot-ssi": "off",
    "upgrade-browser-sdk-v7": "off",
    "verify-ssi": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/takeshiemoto/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "coderabbit@claude-plugins-official": true,
    "codex@openai-codex": true,
    "crit@crit": true,
    "example-skills@anthropic-agent-skills": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "langfuse-observability@langfuse-observability": true,
    "samba4@samba4-testcases": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/skills.git"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    },
    "langfuse-observability": {
      "source": {
        "source": "github",
        "repo": "langfuse/Claude-Observability-Plugin"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "samba4-testcases": {
      "source": {
        "source": "github",
        "repo": "chatwork-st/samba4-testcases"
      }
    }
  },
  "effortLevel": "xhigh",
  "pluginConfigs": {
    "langfuse-observability@langfuse-observability": {
      "options": {
        "LANGFUSE_BASE_URL": "http://localhost:3000",
        "LANGFUSE_PUBLIC_KEY": "pk-lf-a98af76d-8820-4e54-afcd-6d4c245ba2ce"
      }
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: unknown — no remotes configured and origin/HEAD unset for this repo",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo only (no remotes configured) — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: The git repository at /Users/takeshiemoto (its working directory) — no remotes are configured, and it currently tracks 0 files",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
