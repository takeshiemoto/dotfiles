{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5"
  },
  "attribution": {
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(aws * describe-*)",
      "Bash(aws * list-*)",
      "Bash(aws * get-*)",
      "Bash(aws * batch-get-*)",
      "Bash(aws * search-*)",
      "Bash(aws * head-*)",
      "Bash(aws s3 ls:*)",
      "Bash(aws logs tail:*)",
      "Bash(aws logs filter-log-events:*)",
      "Bash(aws logs start-query:*)",
      "Bash(aws logs start-live-tail:*)",
      "Bash(aws cloudtrail lookup-events:*)",
      "Bash(aws dynamodb query:*)",
      "Bash(aws dynamodb scan:*)",
      "Bash(aws configure list:*)",
      "Bash(aws configure get:*)",
      "Bash(aws help)",
      "Bash(aws --version)",
      "Bash(cd:*)",
      "Bash(grep:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-1[1m]",
  "skillOverrides": {
    "agent-install": "off",
    "code-review": "off",
    "dd-audit": "off",
    "dd-audit-ai-activity": "off",
    "dd-audit-compliance-report": "off",
    "dd-audit-cost-spike-investigation": "off",
    "dd-audit-key-compromise": "off",
    "dd-audit-security-investigation": "off",
    "dd-browser-sdk": "off",
    "dd-docs": "off",
    "enable-ssi": "off",
    "find-skills": "off",
    "k9-ownership-byod-setup": "off",
    "llm-obs-eval-bootstrap": "off",
    "llm-obs-eval-pipeline": "off",
    "llm-obs-experiment-analyzer": "off",
    "llm-obs-session-classify": "off",
    "llm-obs-trace-rca": "off",
    "onboarding-summary": "off",
    "service-remapping": "off",
    "setup-matt-pocock-skills": "off",
    "triage-flaky-test": "off",
    "troubleshoot-ssi": "off",
    "upgrade-browser-sdk-v7": "off",
    "verify-ssi": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/takeshiemoto/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "coderabbit@claude-plugins-official": true,
    "codex@openai-codex": true,
    "crit@crit": true,
    "example-skills@anthropic-agent-skills": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "langfuse-observability@langfuse-observability": true,
    "samba4@samba4-testcases": true,
    "slack@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/skills.git"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    },
    "langfuse-observability": {
      "source": {
        "source": "github",
        "repo": "langfuse/Claude-Observability-Plugin"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "samba4-testcases": {
      "source": {
        "source": "github",
        "repo": "chatwork-st/samba4-testcases"
      }
    }
  },
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "langfuse-observability@langfuse-observability": {
      "options": {
        "LANGFUSE_BASE_URL": "http://localhost:3000",
        "LANGFUSE_PUBLIC_KEY": "pk-lf-a98af76d-8820-4e54-afcd-6d4c245ba2ce"
      }
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "agentPushNotifEnabled": true
}
