#!/bin/bash
# chezmoi modify_ script for ~/.codex/config.toml
#
# Codex rewrites this file at runtime (trust entries, plugins, marketplaces,
# desktop state, …) and the set of things it writes grows with each release.
# So we enforce only the managed keys/sections below and pass everything else
# through verbatim — Codex's own writes must never produce a permanent diff.
# The current file arrives on stdin; our stdout is the target.
set -euo pipefail

home="{{ .chezmoi.homeDir }}"
current="$(cat)"

out="$(printf '%s\n' "$current" | awk -v home="$home" '
function managed_body(h) {
  if (h == "[projects.\"" home "\"]") return "trust_level = \"trusted\""
  if (h == "[mcp_servers.context7]") return "command = \"npx\"\nargs = [\"-y\", \"@upstash/context7-mcp\"]"
  if (h == "[plugins.\"github@openai-curated\"]") return "enabled = true"
  if (h == "[tui]") return "status_line = [\"model-with-reasoning\", \"context-remaining\", \"context-used\", \"five-hour-limit\", \"weekly-limit\"]"
  return ""
}
BEGIN {
  print "model = \"gpt-5.5\""
  print "model_reasoning_effort = \"medium\""
  managed_top["model"] = 1
  managed_top["model_reasoning_effort"] = 1
  n = split("[projects.\"" home "\"]\n[mcp_servers.context7]\n[plugins.\"github@openai-curated\"]\n[tui]", headers, "\n")
  in_top = 1
  skip = 0
}
/^\[/ {
  in_top = 0
  if (managed_body($0) != "") {
    if (!seen[$0]) { print $0; print managed_body($0); print ""; seen[$0] = 1 }
    skip = 1
    next
  }
  skip = 0
  print
  next
}
{
  if (in_top) {
    key = $0
    sub(/[ \t]*=.*/, "", key)
    if (key in managed_top) next
    print
    next
  }
  if (!skip) print
}
END {
  for (i = 1; i <= n; i++)
    if (!seen[headers[i]]) { print ""; print headers[i]; print managed_body(headers[i]) }
}
')"

printf '%s\n' "$out"
