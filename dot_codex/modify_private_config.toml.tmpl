#!/bin/bash
# chezmoi modify_ script for ~/.codex/config.toml
#
# Codex rewrites this file at runtime (trust entries, plugins, marketplaces,
# desktop state, …) and the set of things it writes grows with each release.
# So we enforce only the managed keys/sections below and pass everything else
# through verbatim — Codex's own writes must never produce a permanent diff.
# Managed top-level keys come in two tiers: forced keys are always rewritten,
# seed keys are written only when absent so values toggled from the Codex UI
# (model, reasoning effort) survive `chezmoi apply`.
# The current file arrives on stdin; our stdout is the target.
set -euo pipefail

home="{{ .chezmoi.homeDir }}"
current="$(cat)"

out="$(printf '%s\n' "$current" | awk -v home="$home" '
function managed_body(h) {
  if (h == "[projects.\"" home "\"]") return "trust_level = \"trusted\""
  if (h == "[mcp_servers.context7]") return "command = \"npx\"\nargs = [\"-y\", \"@upstash/context7-mcp\"]"
  if (h == "[plugins.\"github@openai-curated\"]") return "enabled = true"
  if (h == "[plugins.\"tracing@codex-observability-plugin\"]") return "enabled = true"
  if (h == "[features]") return "hooks = true\nterminal_resize_reflow = true\njs_repl = false\nmemories = true\nchronicle = false\nplugin_hooks = true"
  if (h == "[tui]") return "status_line = [\"model-with-reasoning\", \"context-remaining\", \"context-used\", \"five-hour-limit\", \"weekly-limit\"]"
  if (h == "[sandbox_workspace_write]") return "network_access = true\nwritable_roots = [\"" home "/Desktop\"]"
  return ""
}
function print_missing_seeds(   i) {
  for (i = 1; i <= n_seed; i++)
    if (!seen_top[seed_keys[i]]) print seed_keys[i] " = " seed_top[seed_keys[i]]
}
BEGIN {
  print "approval_policy = \"on-request\""
  print "approvals_reviewer = \"auto_review\""
  print "sandbox_mode = \"workspace-write\""
  managed_top["approval_policy"] = 1
  managed_top["approvals_reviewer"] = 1
  managed_top["sandbox_mode"] = 1
  seed_top["model"] = "\"gpt-6-astra\""
  seed_top["model_reasoning_effort"] = "\"low\""
  seed_top["service_tier"] = "\"default\""
  n_seed = split("model\nmodel_reasoning_effort\nservice_tier", seed_keys, "\n")
  n = split("[projects.\"" home "\"]\n[mcp_servers.context7]\n[plugins.\"github@openai-curated\"]\n[plugins.\"tracing@codex-observability-plugin\"]\n[features]\n[tui]\n[sandbox_workspace_write]", headers, "\n")
  in_top = 1
  skip = 0
}
/^\[/ {
  if (in_top) { print_missing_seeds(); in_top = 0 }
  if (managed_body($0) != "") {
    if (!seen[$0]) { print $0; print managed_body($0); print ""; seen[$0] = 1 }
    skip = 1
    next
  }
  skip = 0
  print
  next
}
{
  if (in_top) {
    key = $0
    sub(/[ \t]*=.*/, "", key)
    if (key in managed_top) next
    if (key in seed_top) seen_top[key] = 1
    print
    next
  }
  if (!skip) print
}
END {
  if (in_top) print_missing_seeds()
  for (i = 1; i <= n; i++)
    if (!seen[headers[i]]) { print ""; print headers[i]; print managed_body(headers[i]) }
}
')"

printf '%s\n' "$out"
