{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "permissions": {
    "deny": [],
    "ask": [
      "Bash(git push*)",
      "Bash(rm *)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ],
    "defaultMode": "plan"
  },
  "language": "japanese",
  "model": "opus",
  "outputStyle": "Explanatory",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "REDACTED-REDACTED@REDACTED-storage-plugins": true,
    "REDACTED-basic@REDACTED-storage-plugins": true,
    "feature-dev@claude-plugins-official": true,
    "codex@openai-codex": true,
    "takeshiemoto@takeshiemoto-marketplace": true
  },
  "extraKnownMarketplaces": {
    "REDACTED-storage-plugins": {
      "source": {
        "source": "github",
        "repo": "REDACTED-st/REDACTED-storage-claude-plugin"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "takeshiemoto-marketplace": {
      "source": {
        "source": "github",
        "repo": "takeshiemoto/claude-code-my-marketplace"
      },
      "autoUpdate": true
    }
  }
}
